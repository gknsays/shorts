# --- Google Gemini API (senaryo/başlık/açıklama üretimi) ---
# ÜCRETSİZ: aistudio.google.com üzerinden kredi kartı gerekmeden alınır.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Microsoft Edge TTS (Türkçe seslendirme + kelime zaman damgaları) ---
# ÜCRETSİZ ve API ANAHTARI GEREKTİRMEZ. Aşağıdaki satırları olduğu gibi bırakabilirsin.
# tr-TR-EmelNeural (kadın) veya tr-TR-AhmetNeural (erkek)
EDGE_TTS_VOICE=tr-TR-EmelNeural
EDGE_TTS_RATE=+6%

# --- Pexels (dikey stok arka plan videosu) ---
# ÜCRETSİZ: pexels.com/api üzerinden anında alınır.
PEXELS_API_KEY=

# --- YouTube Data API v3 (OAuth) ---
# ÜCRETSİZ: Google Cloud Console üzerinden (kredi kartı gerekmez).
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REDIRECT_URI=http://localhost:8765/oauth2callback
# public | unlisted | private  (test ederken "unlisted" veya "private" öner)
YT_PRIVACY_STATUS=public

# Kanalin nisi (virgulle ayrilmis kategori adlari). Bos birakilirsa 15 kategorilik
# genis havuz kullanilir; kanal buyuyene kadar 2-3 kategoriye daraltmak onerilir.
CATEGORY_FILTER=Ev Tamiratı & Tadilat,Araba Bakımı & Sürüş,Ev Güvenliği & Acil Durum Bilgisi

# Ikinci ucretsiz stok video kaynagi (opsiyonel ama onerilir)
PIXABAY_API_KEY=

# Her videoya eklenen sabit kanal etiketleri
CHANNEL_TAGS=kendin yap,ustadan tüyo,pratik bilgiler
